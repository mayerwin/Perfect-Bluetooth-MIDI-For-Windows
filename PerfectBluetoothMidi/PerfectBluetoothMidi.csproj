<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0-windows10.0.26100.0 gives us Windows 11 24H2 WinRT projections
         (Windows.Devices.Bluetooth.*, Windows.Devices.Enumeration.*) AND
         matches the Windows SDK build the WMS App SDK (Microsoft.Windows.Devices.Midi2)
         was compiled against. The Windows MIDI Services service ships in-box
         starting with Windows 11 24H2, so the runtime constraint is the same
         either way; we keep SupportedOSPlatformVersion at 10.0.19041.0 so the
         classic-MIDI loopback fallback path still loads on older builds.
         .NET 10 is the current LTS (Nov 2025 / supported through Nov 2028). -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PerfectBluetoothMidi</RootNamespace>
    <AssemblyName>PerfectBluetoothMidi</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <Product>Perfect Bluetooth MIDI</Product>
    <Company>Erwin Mayer</Company>
    <Description>Perfect Bluetooth MIDI — bridges a Bluetooth LE MIDI device (Roland FP-90X, WIDI Master, CME, Yamaha MD-BT01, …) into the new Windows MIDI Services stack so any DAW or Web MIDI site can use it as if it were wired.</Description>

    <!-- Avalonia: modern cross-platform XAML UI. Fluent theme ships with
         the Themes.Fluent package, and compiled bindings give us type-safe
         XAML + catch typos at build time. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Publish defaults. These don't affect F5/Debug builds (they only kick
         in on `dotnet publish`), so dev iteration stays fast. RuntimeIdentifier
         and SelfContained are passed on the command line by BUILD.bat. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>

    <!-- Trim the Windows SDK projections (Microsoft.Windows.SDK.NET.dll is
         ~26 MB uncompressed on disk — it projects the ENTIRE Windows 10/11
         WinRT surface) down to just the types/members we actually call.
         TrimMode "partial" leaves our own assemblies and Avalonia alone
         (both use reflection in places the linker can't fully prove safe),
         and only trims assemblies that opt in — in practice the SDK
         projection, which IS trim-safe. Net effect on this project: roughly
         halves the single-file exe. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia 11.2.x — last stable as of April 2026 is 11.2.3.
         Desktop brings the classic-desktop startup lifetime and Win32 backend.
         Themes.Fluent adds the Fluent design-system theme. -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />

    <!-- Windows MIDI Services App SDK. Lets us programmatically create a
         virtual UMP endpoint that lives only while this app is running, so
         users no longer have to pre-create a loopback in MIDI Settings.
         This package is NOT on nuget.org — it's vendored from the GitHub
         release as nuget-packages/Microsoft.Windows.Devices.Midi2.*.nupkg
         (see NuGet.config and BUILD.bat for the local-feed wiring).

         Runtime: requires the user to have installed the matching
         "Windows MIDI Services SDK Runtime and Tools" .exe (also from the
         GitHub release). The app uses MidiDesktopAppSdkInitializer at
         startup to detect the runtime; if absent, it falls back to the
         legacy WMS-loopback UX (which only needs the in-box service). -->
    <PackageReference Include="Microsoft.Windows.Devices.Midi2" Version="1.0.17-rc.4.25" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia's SDK integration auto-globs *.axaml into AvaloniaResource,
         so we do NOT add an explicit <AvaloniaResource Include="**/*.axaml"/>
         here — doing so registers every XAML file twice and the compiler
         rejects the build with AVLN2002 "Duplicate x:Class".
         We still opt the app icon in explicitly; it's not in the default globs.
         This makes Window.Icon="/app.ico" work and lets code load the icon
         at runtime via avares://PerfectBluetoothMidi/app.ico. -->
    <AvaloniaResource Include="app.ico" />
  </ItemGroup>

</Project>
