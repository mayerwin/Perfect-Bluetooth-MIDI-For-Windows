<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PerfectBluetoothMidi.App">

  <!--
    Theme system:
      • Fluent theme provides the baseline (buttons, combobox, textbox, …).
      • Our semantic colour tokens live in ThemeDictionaries so a runtime
        ThemeVariant flip (Light ⇄ Dark) re-resolves every DynamicResource
        consumer automatically. Window/style setters reference tokens by key
        — don't hard-code hex values downstream.
      • The theme variant itself is decided in App.axaml.cs on startup
        (default = System). The combo in MainWindow updates it at runtime
        and persists the choice to %AppData%\PerfectBluetoothMidi.
  -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <!-- ═════════════════════ LIGHT ═════════════════════ -->
        <ResourceDictionary x:Key="Light">
          <Color x:Key="AppBgColor">#F6F7FA</Color>
          <Color x:Key="CardBgColor">#FFFFFF</Color>
          <Color x:Key="CardBorderColor">#E1E3E8</Color>
          <Color x:Key="TextPrimaryColor">#1A1C22</Color>
          <Color x:Key="TextSecondaryColor">#3B3F47</Color>
          <Color x:Key="TextMutedColor">#6C707A</Color>
          <Color x:Key="AccentColor">#0078D7</Color>
          <Color x:Key="AccentHoverColor">#1A88E5</Color>
          <Color x:Key="AccentActiveColor">#0066C0</Color>
          <Color x:Key="AccentDisabledColor">#BCD8F2</Color>
          <Color x:Key="LogBgColor">#FCFCFD</Color>
          <Color x:Key="LogBorderColor">#E4E6EB</Color>
          <Color x:Key="InfoBoxBgColor">#F0F4FA</Color>
          <Color x:Key="InfoBoxBorderColor">#D6E4F4</Color>
          <Color x:Key="StatusConnectedColor">#16841C</Color>
          <Color x:Key="StatusDisconnectedColor">#ACB0B8</Color>

          <SolidColorBrush x:Key="AppBgBrush"              Color="{StaticResource AppBgColor}"/>
          <SolidColorBrush x:Key="CardBgBrush"             Color="{StaticResource CardBgColor}"/>
          <SolidColorBrush x:Key="CardBorderBrush"         Color="{StaticResource CardBorderColor}"/>
          <SolidColorBrush x:Key="TextPrimaryBrush"        Color="{StaticResource TextPrimaryColor}"/>
          <SolidColorBrush x:Key="TextSecondaryBrush"      Color="{StaticResource TextSecondaryColor}"/>
          <SolidColorBrush x:Key="TextMutedBrush"          Color="{StaticResource TextMutedColor}"/>
          <SolidColorBrush x:Key="AccentBrush"             Color="{StaticResource AccentColor}"/>
          <SolidColorBrush x:Key="AccentHoverBrush"        Color="{StaticResource AccentHoverColor}"/>
          <SolidColorBrush x:Key="AccentActiveBrush"       Color="{StaticResource AccentActiveColor}"/>
          <SolidColorBrush x:Key="AccentDisabledBrush"     Color="{StaticResource AccentDisabledColor}"/>
          <SolidColorBrush x:Key="LogBgBrush"              Color="{StaticResource LogBgColor}"/>
          <SolidColorBrush x:Key="LogBorderBrush"          Color="{StaticResource LogBorderColor}"/>
          <SolidColorBrush x:Key="InfoBoxBgBrush"          Color="{StaticResource InfoBoxBgColor}"/>
          <SolidColorBrush x:Key="InfoBoxBorderBrush"      Color="{StaticResource InfoBoxBorderColor}"/>
          <SolidColorBrush x:Key="StatusConnectedBrush"    Color="{StaticResource StatusConnectedColor}"/>
          <SolidColorBrush x:Key="StatusDisconnectedBrush" Color="{StaticResource StatusDisconnectedColor}"/>

          <BoxShadows x:Key="CardShadow">0 1 2 0 #10000000</BoxShadows>
        </ResourceDictionary>

        <!-- ═════════════════════ DARK ══════════════════════ -->
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="AppBgColor">#1C1D21</Color>
          <Color x:Key="CardBgColor">#25262A</Color>
          <Color x:Key="CardBorderColor">#35373B</Color>
          <Color x:Key="TextPrimaryColor">#F0F1F3</Color>
          <Color x:Key="TextSecondaryColor">#C9CCD3</Color>
          <Color x:Key="TextMutedColor">#8B8E95</Color>
          <Color x:Key="AccentColor">#3AAAFF</Color>
          <Color x:Key="AccentHoverColor">#5CBAFF</Color>
          <Color x:Key="AccentActiveColor">#1E93E5</Color>
          <Color x:Key="AccentDisabledColor">#395C78</Color>
          <Color x:Key="LogBgColor">#1A1B1F</Color>
          <Color x:Key="LogBorderColor">#2D2E33</Color>
          <Color x:Key="InfoBoxBgColor">#1E2730</Color>
          <Color x:Key="InfoBoxBorderColor">#2E4259</Color>
          <Color x:Key="StatusConnectedColor">#3ECB4A</Color>
          <Color x:Key="StatusDisconnectedColor">#6E737D</Color>

          <SolidColorBrush x:Key="AppBgBrush"              Color="{StaticResource AppBgColor}"/>
          <SolidColorBrush x:Key="CardBgBrush"             Color="{StaticResource CardBgColor}"/>
          <SolidColorBrush x:Key="CardBorderBrush"         Color="{StaticResource CardBorderColor}"/>
          <SolidColorBrush x:Key="TextPrimaryBrush"        Color="{StaticResource TextPrimaryColor}"/>
          <SolidColorBrush x:Key="TextSecondaryBrush"      Color="{StaticResource TextSecondaryColor}"/>
          <SolidColorBrush x:Key="TextMutedBrush"          Color="{StaticResource TextMutedColor}"/>
          <SolidColorBrush x:Key="AccentBrush"             Color="{StaticResource AccentColor}"/>
          <SolidColorBrush x:Key="AccentHoverBrush"        Color="{StaticResource AccentHoverColor}"/>
          <SolidColorBrush x:Key="AccentActiveBrush"       Color="{StaticResource AccentActiveColor}"/>
          <SolidColorBrush x:Key="AccentDisabledBrush"     Color="{StaticResource AccentDisabledColor}"/>
          <SolidColorBrush x:Key="LogBgBrush"              Color="{StaticResource LogBgColor}"/>
          <SolidColorBrush x:Key="LogBorderBrush"          Color="{StaticResource LogBorderColor}"/>
          <SolidColorBrush x:Key="InfoBoxBgBrush"          Color="{StaticResource InfoBoxBgColor}"/>
          <SolidColorBrush x:Key="InfoBoxBorderBrush"      Color="{StaticResource InfoBoxBorderColor}"/>
          <SolidColorBrush x:Key="StatusConnectedBrush"    Color="{StaticResource StatusConnectedColor}"/>
          <SolidColorBrush x:Key="StatusDisconnectedBrush" Color="{StaticResource StatusDisconnectedColor}"/>

          <BoxShadows x:Key="CardShadow">0 1 2 0 #60000000</BoxShadows>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- ===================================================================
         Design tokens + styles.  All visual decisions live here so the app
         reads as a single design system instead of inline hackery.
         =================================================================== -->

    <!-- Elevated "card" surface: 1 px border, generous padding, subtle radius.
         Use: <Border Classes="card"> ... </Border> -->
    <Style Selector="Border.card">
      <Setter Property="Background"      Value="{DynamicResource CardBgBrush}" />
      <Setter Property="BorderBrush"     Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius"    Value="8" />
      <Setter Property="Padding"         Value="18,16" />
      <Setter Property="BoxShadow"       Value="{DynamicResource CardShadow}" />
    </Style>

    <!-- Section heading inside a card ("1  MIDI loopback endpoint"). -->
    <Style Selector="TextBlock.sectionHead">
      <Setter Property="FontSize"     Value="14" />
      <Setter Property="FontWeight"   Value="SemiBold" />
      <Setter Property="Foreground"   Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Margin"       Value="0,0,0,2" />
    </Style>

    <!-- Secondary/help text just below a section heading. -->
    <Style Selector="TextBlock.sectionSub">
      <Setter Property="FontSize"      Value="12" />
      <Setter Property="Foreground"    Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextWrapping"  Value="Wrap" />
      <Setter Property="Margin"        Value="0,0,0,10" />
      <Setter Property="LineHeight"    Value="17" />
    </Style>

    <!-- App title in the header. -->
    <Style Selector="TextBlock.appTitle">
      <Setter Property="FontSize"   Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Primary (accent) button. -->
    <Style Selector="Button.accent">
      <Setter Property="Background"    Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground"    Value="White" />
      <Setter Property="FontWeight"    Value="SemiBold" />
      <Setter Property="Padding"       Value="14,6" />
      <Setter Property="CornerRadius"  Value="4" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background"  Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="Foreground"  Value="White" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
      <Setter Property="Background"  Value="{DynamicResource AccentActiveBrush}" />
      <Setter Property="Foreground"  Value="White" />
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter">
      <Setter Property="Background"  Value="{DynamicResource AccentDisabledBrush}" />
      <Setter Property="Foreground"  Value="White" />
    </Style>

    <!-- Status pill dot (●). Fill is set in code from the StatusConnected /
         StatusDisconnected theme brushes so it re-themes automatically. -->
    <Style Selector="Ellipse.statusDot">
      <Setter Property="Width"  Value="10" />
      <Setter Property="Height" Value="10" />
    </Style>

    <!-- The monospaced activity log. -->
    <Style Selector="TextBox.log">
      <Setter Property="FontFamily"        Value="Consolas,Menlo,monospace" />
      <Setter Property="FontSize"          Value="12" />
      <Setter Property="IsReadOnly"        Value="True" />
      <Setter Property="AcceptsReturn"     Value="True" />
      <Setter Property="TextWrapping"      Value="NoWrap" />
      <Setter Property="Background"        Value="{DynamicResource LogBgBrush}" />
      <Setter Property="BorderBrush"       Value="{DynamicResource LogBorderBrush}" />
      <Setter Property="BorderThickness"   Value="1" />
      <Setter Property="CornerRadius"      Value="4" />
      <Setter Property="Padding"           Value="8,6" />
      <Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </Application.Styles>

</Application>
