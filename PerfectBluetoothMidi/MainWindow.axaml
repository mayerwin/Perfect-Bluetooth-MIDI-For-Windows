<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PerfectBluetoothMidi"
        x:Class="PerfectBluetoothMidi.MainWindow"
        Title="Perfect Bluetooth MIDI"
        Width="1040" Height="760"
        MinWidth="820" MinHeight="760"
        Background="{DynamicResource AppBgBrush}"
        Icon="/app.ico"
        WindowStartupLocation="CenterScreen">

  <!--
    Grid lets the activity log (row 3, "*") grow to fill whatever vertical
    space remains. Rows 0-2 are Auto so they're exactly as tall as their
    content.  This is the architectural fix that WinForms' TableLayoutPanel
    kept failing at — Avalonia's layout pass is predictable and honours
    star-sizing the way modern UI frameworks do.
  -->
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20,14,20,14">

    <!-- =================================================================
         Row 0 — Header: title on the left, connection pill on the right.
         ================================================================= -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <TextBlock Grid.Column="0"
                 Classes="appTitle"
                 Text="Perfect Bluetooth MIDI"
                 VerticalAlignment="Center"/>

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Spacing="8">
        <!-- Theme selector — 3 options, System default. Sits at the left of
             the status pill per the design. Items populated in code-behind. -->
        <ComboBox x:Name="ThemeCombo"
                  MinWidth="110"
                  Margin="0,0,16,0"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Switch between Light, Dark, and System-follow theme."/>
        <Ellipse x:Name="StatusDot"
                 Classes="statusDot"/>
        <TextBlock x:Name="StatusText"
                   Text="Disconnected"
                   Foreground="{DynamicResource TextMutedBrush}"
                   VerticalAlignment="Center"/>
        <Button x:Name="HideToTrayBtn"
                Content="Hide to tray"
                Margin="16,0,0,0"
                Padding="10,4"
                ToolTip.Tip="Keep the bridge running in the background. Bring the window back from the system tray icon."/>
      </StackPanel>
    </Grid>

    <!-- =================================================================
         Row 1 — Setup strip: loopback card + BLE card side-by-side.
         Two 50% columns with a 16 px gutter between them.
         ================================================================= -->
    <Grid Grid.Row="1"
          ColumnDefinitions="*,16,*"
          Margin="0,0,0,14">

      <!-- Card 1: Host MIDI endpoint. Two panels share this card; only one
           is visible at a time, picked by the active backend (auto-detected
           at startup based on whether the WMS App SDK runtime is installed). -->
      <Border Grid.Column="0" Classes="card">
        <Grid>

          <!-- Virtual-device panel: the modern path. Shown when the WMS App
               SDK runtime is installed. The endpoint is created on-demand
               with the user-supplied name; no pre-flight loopback setup. -->
          <StackPanel x:Name="VirtualPanel" Spacing="0" IsVisible="False">
            <TextBlock Classes="sectionHead" Text="1  Virtual MIDI port"/>
            <TextBlock Classes="sectionSub"
                       Text="Choose the name your DAW or Chrome Web MIDI site (like Midiano) will see. The port appears while this app runs."/>

            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
              <TextBox x:Name="VirtualPortNameBox"
                       Grid.Column="0"
                       MinHeight="32"
                       VerticalContentAlignment="Center"/>
              <Button x:Name="VirtualPortApplyBtn"
                      Grid.Column="1"
                      Margin="8,0,0,0"
                      Content="Apply"
                      ToolTip.Tip="Save the name. If the bridge is already running, restart it to apply."/>
            </Grid>

            <!-- Backend-switch section. Visually demarcated by hairline
                 borders above and below so it reads as its own affordance,
                 not part of the main port-naming flow. The link itself
                 stays muted — we don't want to encourage users away from
                 the virtual-device backend. -->
            <Border BorderBrush="{DynamicResource LogBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,12,0,0"/>
            <Button x:Name="UseLoopbackInsteadBtn"
                    Classes="link"
                    Content="Use a classic loopback endpoint instead…"
                    HorizontalAlignment="Left"
                    Foreground="{DynamicResource TextMutedBrush}"
                    FontSize="11"
                    Margin="0,8,0,8"
                    ToolTip.Tip="Switch this app to the legacy WMS-loopback path (requires a loopback endpoint in MIDI Settings)."/>
            <Border BorderBrush="{DynamicResource LogBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,0,0,10"/>

            <!-- Combined DAW-side hint (port name + restart-host reminder).
                 Set in code-behind so the {name} part stays in sync with
                 whatever the user typed and Applied. -->
            <TextBlock x:Name="VirtualDawHint"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       LineHeight="17"
                       Margin="0,2,0,0"/>

            <Button x:Name="VirtualMidianoBtn"
                    Classes="link"
                    Content="Try it with Midiano — nice song catalog…"
                    HorizontalAlignment="Left"
                    Foreground="{DynamicResource AccentBrush}"
                    Margin="0,8,0,0"
                    ToolTip.Tip="Opens app.midiano.com in your browser."/>
          </StackPanel>

          <!-- Loopback panel: the legacy path. Shown when the WMS App SDK
               runtime isn't installed, or when the user explicitly opted
               into the loopback backend in app.json. -->
          <StackPanel x:Name="LoopbackPanel" Spacing="0" IsVisible="False">
            <TextBlock Classes="sectionHead" Text="1  MIDI loopback endpoint"/>
            <TextBlock Classes="sectionSub"
                       Text="Any DAW or Chrome Web MIDI site (like Midiano) opens this as a virtual MIDI device."/>

            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
              <ComboBox x:Name="PortCombo"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        MinHeight="32"/>
              <Button x:Name="RefreshPortsBtn"
                      Grid.Column="1"
                      Margin="8,0,0,0"
                      Content="Refresh"/>
            </Grid>

            <!-- Backend-switch section. One of UseVirtualInsteadBtn /
                 InstallSdkRuntimeBtn is visible at a time, picked by
                 ApplyBackendVisibility based on whether the WMS App SDK
                 runtime is detected on this machine. Visually delimited so
                 it's findable without crowding the loopback-picking UI. -->
            <Border BorderBrush="{DynamicResource LogBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,12,0,0"/>
            <Button x:Name="UseVirtualInsteadBtn"
                    Classes="link"
                    Content="Use a virtual MIDI port instead (no loopback needed)…"
                    HorizontalAlignment="Left"
                    Foreground="{DynamicResource TextMutedBrush}"
                    FontSize="11"
                    Margin="0,8,0,8"
                    IsVisible="False"
                    ToolTip.Tip="Switch to the WMS App SDK virtual-device backend. The app will declare its own MIDI port on demand; no loopback to create."/>
            <Button x:Name="InstallSdkRuntimeBtn"
                    Classes="link"
                    Content="Install the WMS App SDK Runtime to skip this step…"
                    HorizontalAlignment="Left"
                    Foreground="{DynamicResource TextMutedBrush}"
                    FontSize="11"
                    Margin="0,8,0,8"
                    IsVisible="False"
                    ToolTip.Tip="Opens the Microsoft MIDI releases page. Once installed, this app will create a virtual port on its own — no loopback needed."/>
            <Border BorderBrush="{DynamicResource LogBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,0,0,10"/>

            <Button x:Name="LoopbackHelpBtn"
                    Classes="link"
                    Content="How to create a loopback endpoint…"
                    HorizontalAlignment="Left"
                    Foreground="{DynamicResource AccentBrush}"
                    Margin="0,2,0,0"/>

            <!-- Combined DAW-side hint (which side to pick + restart-host
                 reminder). Set in code-behind. -->
            <TextBlock x:Name="DawHint"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       LineHeight="17"
                       Margin="0,6,0,0"/>

            <Button x:Name="MidianoBtn"
                    Classes="link"
                    Content="Try it with Midiano — nice song catalog…"
                    HorizontalAlignment="Left"
                    Foreground="{DynamicResource AccentBrush}"
                    Margin="0,8,0,0"
                    ToolTip.Tip="Opens app.midiano.com in your browser. Pick the same loopback endpoint the DAW-side hint above tells you to."/>
          </StackPanel>

        </Grid>
      </Border>

      <!-- Card 2: BLE device -->
      <Border Grid.Column="2" Classes="card">
        <StackPanel Spacing="0">
          <TextBlock Classes="sectionHead" Text="2  Bluetooth MIDI device"/>
          <TextBlock Classes="sectionSub"
                     Text="Turn BLE MIDI on at the device, then Scan. FP-90X: Function → Bluetooth → On."/>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button x:Name="ScanBtn"   Content="Scan for BLE MIDI"/>
            <Button x:Name="ConnectBtn" Classes="accent" Content="Connect" IsEnabled="False"/>
          </StackPanel>

          <!-- Device list — fixed height keeps the card compact. -->
          <ListBox x:Name="DevicesList"
                   Height="92"
                   BorderBrush="{DynamicResource LogBorderBrush}"
                   BorderThickness="1"
                   CornerRadius="4"/>

          <!-- Auto-reconnect at launch. The MAC of the last connected
               device is persisted in app.json; on next launch we scan
               and, if that device shows up, connect to it automatically. -->
          <CheckBox x:Name="AutoReconnectBox"
                    Content="Auto-scan and reconnect at launch"
                    Margin="0,8,0,0"
                    ToolTip.Tip="On launch, scan for the last connected device and connect automatically when it advertises. Disable if you'd rather always pick manually."/>

          <!-- MIDI TX channel row: rewrite outgoing channel nibble to match the
               device's RX channel. Some pianos (Roland FP-90X) receive on a
               different channel than their Transmit Channel setting suggests.
               Auto-saved per BLE MAC in %AppData%\PerfectBluetoothMidi\devices.json. -->
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center"
                      Margin="0,10,0,0">
            <TextBlock Text="TX channel:"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ComboBox x:Name="ChannelCombo"
                      MinWidth="90"
                      MinHeight="30"
                      ToolTip.Tip="Outgoing MIDI channel for this device. 'Passthrough' keeps the channel in each message untouched."/>
            <Button x:Name="DetectChannelBtn"
                    Content="Detect…"
                    Padding="10,4"
                    IsEnabled="False"
                    ToolTip.Tip="Play N ascending notes on each channel. Count the notes you hear — that's the device's receive channel."/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- =================================================================
         Row 2 — Keyboard card.
         ================================================================= -->
    <Border Grid.Row="2" Classes="card" Margin="0,0,0,14">
      <StackPanel Spacing="0">
        <TextBlock Classes="sectionHead" Text="3  Test the link  (piano ⇄ PC)"/>
        <TextBlock Classes="sectionSub"
                   Text="Play a note on the piano — the matching key lights blue. Click keys here, or press A S D F G H J / W E T Y U to send notes back."/>

        <!-- Custom Control rendered via DrawingContext. Height kept compact
             so the activity log gets meaningful space at the window's
             MinHeight without forcing a tall MinHeight that would overflow
             smaller screens. The black-key proportion in PianoKeyboard.cs
             was also reduced so the keys still look right at this height. -->
        <local:PianoKeyboard x:Name="Keyboard"
                             Height="90"
                             Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <!-- =================================================================
         Row 3 — Activity log fills remaining space.
         ================================================================= -->
    <Border Grid.Row="3" Classes="card">
      <Grid RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.Row="0" Classes="sectionHead" Text="Activity"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="16"
                    Margin="0,4,0,8">
          <CheckBox x:Name="VerboseBox"
                    Content="Verbose logging (per-message diagnostics)"/>
          <Button   x:Name="ClearLogBtn" Content="Clear"/>
          <Button   x:Name="SaveLogBtn"  Content="Save log…"/>
        </StackPanel>

        <!-- MinHeight ensures the log keeps several lines visible even when
             the user shrinks the window all the way down to the window-level
             MinHeight. The Grid above otherwise gives this row "*" sizing,
             which lets it collapse to zero when the auto-sized rows above
             already fill the available height. -->
        <TextBox x:Name="LogBox"
                 Grid.Row="2"
                 MinHeight="80"
                 Classes="log"/>
      </Grid>
    </Border>
  </Grid>

  <!-- Tray icon is wired up in code-behind (InstallTrayIcon): Avalonia
       attaches the TrayIcons list to Application.Current, not the window. -->

</Window>
