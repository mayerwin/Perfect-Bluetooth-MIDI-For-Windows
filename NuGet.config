<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides any user- or machine-level package feeds for this repo.
     Without <clear/>, dotnet walks up to %AppData%\NuGet\NuGet.Config and
     picks up private feeds (we saw Azure DevOps "mayerwin.pkgs" here), which
     causes NU1900 warnings when they're unreachable.

     The Windows MIDI Services App SDK (Microsoft.Windows.Devices.Midi2) is
     not on nuget.org — Microsoft ships it as a .nupkg asset on GitHub
     Releases (https://github.com/microsoft/MIDI/releases). We vendor a
     specific RC into ./nuget-packages/ for reproducible offline-capable
     builds and pin its source to that folder via packageSourceMapping.
     When updating: drop the new .nupkg into nuget-packages/, bump the
     PackageReference Version in PerfectBluetoothMidi.csproj, delete
     obj/project.assets.json, and re-run dotnet restore. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-wms-sdk" value="./nuget-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-wms-sdk">
      <package pattern="Microsoft.Windows.Devices.Midi2*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
