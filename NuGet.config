<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides any user- or machine-level package feeds for this repo.
     Without <clear/>, dotnet walks up to %AppData%\NuGet\NuGet.Config and
     picks up private feeds (we saw Azure DevOps "mayerwin.pkgs" here), which
     causes NU1900 warnings when they're unreachable. We don't need any
     custom feed — only nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
